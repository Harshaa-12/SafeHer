# SafeHer Production Environment Configuration Example
# Copy this file to .env and replace placeholders with real keys before deployment.

# ==========================================
# FLASK CORE CONFIGURATION
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_32_chars_min
FLASK_HOST=0.0.0.0
# PORT is automatically injected by free platforms like Render ($PORT). Falls back to FLASK_PORT / 5000:
PORT=5000
FLASK_PORT=5000

# Database: Leave unset to use local SQLite (safeher.db) for development.
# Provide a PostgreSQL connection string (Render/Neon/Supabase) to enable PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/database

# CORS Configuration:
# Allow origins separated by commas. Set FRONTEND_URL to your hosted frontend when ready.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
FRONTEND_URL=

# ==========================================
# MSG91 SMS PROVIDER (INDIA DLT COMPLIANT)
# ==========================================
# Obtain from https://control.msg91.com/
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SFEHER

# ==========================================
# META WHATSAPP CLOUD API PROVIDER
# ==========================================
# Obtain from Meta for Developers -> WhatsApp -> API Setup
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v20.0
META_WA_TEMPLATE_NAME=safeher_sos_alert
META_WA_LANGUAGE=en

# Meta Webhook Verification (Optional, for real-time delivery status)
META_APP_SECRET=
META_WA_VERIFY_TOKEN=safeher_webhook_verify_token_2026
